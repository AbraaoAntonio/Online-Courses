# Opcional: habilita a leitura automática de imagens de produto via Claude Vision.
# Sem isso, o app funciona normalmente, mas exige uma descrição em texto.
ANTHROPIC_API_KEY=

# Modelo usado para interpretar as imagens (opcional, tem um padrão razoável).
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Timeout (em segundos) para cada site consultado na comparação de preços.
SCRAPER_TIMEOUT_SECONDS=10
